# ==========================================
# KindBridge - Environment Variables Example
# Copy this file to .env and fill in values
# NEVER COMMIT .env TO GIT
# ==========================================

# --- Database (Somee SQL Server) ---
# ODBC connection string:
DATABASE_URL=DRIVER={ODBC Driver 18 for SQL Server};SERVER=KindBridge.mssql.somee.com;DATABASE=KindBridge;UID=your_db_user;PWD=your_db_password;TrustServerCertificate=yes

# --- Security ---
# Generate JWT_SECRET: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_jwt_secret_key_here

# Generate ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_encryption_key_here

# Set to false only for local http:// development; production cookies must be Secure.
COOKIE_SECURE=true
# bcrypt cost; must be >= 12
BCRYPT_ROUNDS=12

# --- First Admin Bootstrap (used once by: python -m db.seed) ---
ADMIN_BOOTSTRAP_EMAIL=admin@kindbridge.org
# Leave empty to be prompted. Remove after seeding.
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=KindBridge Admin
ADMIN_BOOTSTRAP_PHONE=

# --- LLM Configuration ---
# Options: openai | ollama
# Used only for unsafe_travel and ai_rationale. ai_score stays deterministic in code.
LLM_PROVIDER=ollama
# Small local Ollama model with solid Hebrew support.
# Alternatives: llama3.2:3b (faster), qwen2.5:7b (stronger Hebrew, slower).
LLM_MODEL=qwen2.5:3b
# Address of the Ollama Docker container with port 11434 mapped to the host.
# If the agent runs inside a container, use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
# Not required when LLM_PROVIDER=ollama.
OPENAI_API_KEY=your_openai_api_key_here
# Local Ollama in Docker (comments only; run these yourself):
# docker run -d --name ollama -p 11434:11434 -v ollama:/root/.ollama ollama/ollama
# docker exec -it ollama ollama pull <LLM_MODEL>
# Check: curl http://localhost:11434/api/tags

# --- Embeddings ---
# Options: openai | local
# openai -> text-embedding-3-small, and only after OPENAI_API_KEY is a real key
# local  -> all-MiniLM-L6-v2, the fallback when no OpenAI key is configured
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Vector DB (Chroma server) ---
CHROMA_HOST=localhost
CHROMA_PORT=8000

# --- MCP Services & Integrations ---
TAVILY_API_KEY=your_tavily_api_key_here

# --- Gmail notifications (MCP server @artymclabin/gmail-mcp, launched with npx; needs Node.js 18+) ---
# Google Cloud OAuth client of type "Desktop app" (Gmail API enabled, your Gmail added as a Test user).

# Public address of the web app, used forז links inside e-mails.
APP_BASE_URL=http://localhost:5000