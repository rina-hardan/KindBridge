# Copy to .env and fill in. NEVER commit .env

# --- Database (Somee SQL Server) ---
# ODBC connection string, for example:
# DRIVER={ODBC Driver 18 for SQL Server};SERVER=<host>;DATABASE=<db>;UID=<user>;PWD=<password>;TrustServerCertificate=yes
DATABASE_URL=

# --- Security ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- First admin (used once by db/seed.py) ---
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- LLM (interprets Tavily results, writes rationale) ---
# LLM_PROVIDER: openai | ollama
LLM_PROVIDER=
LLM_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=

# --- Embeddings ---
# EMBEDDING_PROVIDER: openai | local
EMBEDDING_PROVIDER=openai

# --- Vector DB (Chroma server) ---
CHROMA_HOST=localhost
CHROMA_PORT=8000

# --- MCP services ---
TAVILY_API_KEY=
GMAIL_MCP_CLIENT_ID=
GMAIL_MCP_CLIENT_SECRET=